pipeline {
    agent any
    environment {
        MONGODB_URI=credentials('mongodb-atlas-uri')
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_REGION= credentials('aws-region')
    }
   stages {
        stage('Setup Environment') {
            steps {
                sh '''
                    if ! command -v npm &> /dev/null; then
                        sudo apt update
                        sudo apt install -y nodejs npm
                    fi

                    if ! command -v go &> /dev/null; then
                        wget https://go.dev/dl/go1.21.9.linux-amd64.tar.gz
                        sudo tar -C /usr/local -xzf go1.21.9.linux-amd64.tar.gz
                        export PATH=$PATH:/usr/local/go/bin
                        echo 'export PATH=$PATH:/usr/local/go/bin' >> ~/.bashrc
                    fi

                    # Install Python and pip (for executor)
                    if ! command -v pip3 &> /dev/null; then
                        sudo apt install -y python3 python3-pip
                    fi
                    # Install pytest (for executor)
                    pip3 install pytest
                    # Install Docker and docker-compose
                    if ! command -v docker &> /dev/null; then
                        sudo apt install -y docker.io
                        sudo systemctl start docker
                        sudo systemctl enable docker
                        sudo usermod -aG docker $USER
                    fi
                    if ! command -v docker-compose &> /dev/null; then
                        sudo curl -L "https://github.com/docker/compose/releases/download/2.20.0/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                        sudo chmod +x /usr/local/bin/docker-compose
                    fi
                '''
            }
        }
        stage('Checkout') {
            steps {
                git branch: 'openlab', url: 'https://github.com/devops-new-world/openlabfree/openlab.git'
                dir('openlabfree/openlab') {
                    sh 'pwd' 
                }
            }
        }
        stage('Install Dependencies') {
            steps {
                dir('openlabfree/openlab') {
                    dir('backend') {
                        sh 'npm install'
                    }
                    dir('executor') {
                        sh 'pip install --no-cache-dir -r requirements.txt'
                    }
                }
            }
        }
        stage('Test Backend') {
            steps {
                dir('openlabfree/openlab/backend') {
                    sh 'npm test || true' 
                }
            }
        }
        // stage('Test Executor') {
        //     steps {
        //         dir('openlabfree/openlab/executor') {
        //             sh 'pytest || true' 
        //         }
        //     }
        // }
        // stage('Test Fetcher') {
        //     steps {
        //         dir('openlabfree/openlab/fetcher') {
        //             sh 'go test ./... || true'  
        //         }
        //     }
        // }

        stage('Build') {
            steps {
                dir('openlabfree/openlab') {
                    sh 'docker-compose build'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('openlabfree/openlab') {
                    sh '''
                        export MONGODB_URI="${MONGODB_URI}"
                        export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
                        export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"
                        export AWS_REGION="${AWS_REGION}"
                        docker-compose up -d
                    '''
                }
                sh '''
                    sudo nginx -t
                    sudo systemctl reload nginx
                '''
            }
        }
    }
    post {
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}