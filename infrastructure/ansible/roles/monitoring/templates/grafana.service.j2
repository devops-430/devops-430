[Unit]
Description=Grafana
Documentation=https://grafana.com/docs/
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/grafana/grafana-10.0.3/bin/grafana-server \
    --config=/opt/grafana/grafana-10.0.3/conf/defaults.ini \
    --homepath=/opt/grafana/grafana-10.0.3
Restart=always

[Install]
WantedBy=multi-user.target 